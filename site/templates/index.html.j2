</footer>
<p class="vh" id="live" aria-live="polite"></p>
<script>
/* Adds to a page that is complete without it: the section in view is marked in the bar. */
(() => {
  const links = [...document.querySelectorAll('.bar a[href^="#"]')];
  const sections = links.map(a => document.querySelector(a.hash)).filter(Boolean);
  if (!("IntersectionObserver" in window) || !sections.length) return;
  const seen = new IntersectionObserver(entries => entries.forEach(e => {
    if (!e.isIntersecting) return;
    links.forEach(a => a.hash === "#" + e.target.id ? a.setAttribute("aria-current", "location") : a.removeAttribute("aria-current"));
  }), { rootMargin: "-40% 0px -55% 0px" });
  sections.forEach(s => seen.observe(s));
  seen.observe(document.querySelector(".top"));  // back at the lede, no section is current
})();
/* The notice of stale data is also judged on the day the page is read, not only on the day it was built. */
(() => {
  const note = document.getElementById("stale");
  const asOf = note && Date.parse(note.dataset.asOf);
  if (!asOf) return;
  const days = Math.floor((Date.now() - asOf) / 864e5);
  if (days > {{ stale_after }}) { note.querySelector("span").textContent = days; note.hidden = false; }
})();
/* The link of a row copies its address, and says so; without a clipboard it is an ordinary link. */
if (navigator.clipboard) document.querySelectorAll("a.perma").forEach(a => {
  a.textContent = "copy link";
  a.setAttribute("aria-label", "Copy link to the " + a.getAttribute("aria-label").replace(/^Link to the /, ""));
});
document.addEventListener("click", e => {
  const a = e.target.closest("a.perma");
  if (!a || !navigator.clipboard) return;
  e.preventDefault();
  navigator.clipboard.writeText(a.href).then(() => {
    document.getElementById("live").textContent = "Link to the row copied";
    a.textContent = "copied";
    setTimeout(() => { a.textContent = "copy link"; document.getElementById("live").textContent = ""; }, 1600);
  }, () => { location.hash = a.hash; });
});
/* The full tables sort by any column: numbers as numbers, text in reading order, blanks last. */
document.querySelectorAll("table.full").forEach(table => {
  const heads = [...table.tHead.rows[0].cells];
  heads.forEach((th, col) => {
    if (th.hasAttribute("data-nosort")) return;
    const button = document.createElement("button");
    button.type = "button"; button.className = "sort";
    button.append(...th.childNodes); th.append(button);
    button.addEventListener("click", () => {
      const up = th.getAttribute("aria-sort") !== "ascending";
      heads.forEach(h => h.removeAttribute("aria-sort"));
      th.setAttribute("aria-sort", up ? "ascending" : "descending");
      const cells = [...table.tBodies[0].rows].map(r => r.cells[col]);
      const num = th.classList.contains("num") || cells.some(c => c.dataset.sort !== undefined);
      const key = row => { const c = row.cells[col], v = (c.dataset.sort ?? c.textContent).trim(); return num ? parseFloat(v) : v; };
      const rows = [...table.tBodies[0].rows].sort((a, b) => {
        const x = key(a), y = key(b);
        const blank = v => v === "" || v === "—" || Number.isNaN(v);
        if (blank(x) || blank(y)) return blank(x) - blank(y);
        return (num ? x - y : x.localeCompare(y, "en", { numeric: true })) * (up ? 1 : -1);
      });
      table.tBodies[0].append(...rows);
    });
  });
});
/* Beside its table, each plot row takes the height of its table row, so a mark never sits beside another work
   item; the plot row of the work item landed on is outlined like its table row. */
(() => {
  const fig = document.querySelector(".fig");
  if (!fig) return;
  const plot = fig.querySelector(".plot"), main = fig.querySelector(".plot-main"), table = fig.querySelector("table");
  const rows = [...fig.querySelectorAll(".plot-row")], trs = [...table.tBodies[0].rows];
  const align = () => {
    const beside = Math.abs(table.getBoundingClientRect().top - plot.getBoundingClientRect().top) < 2;
    rows.forEach((r, i) => { r.style.height = beside && trs[i] ? trs[i].offsetHeight + "px" : ""; });
    beside ? main.style.setProperty("--head", table.tHead.offsetHeight + "px") : main.style.removeProperty("--head");
  };
  const mark = () => {
    const i = trs.findIndex(tr => "#" + tr.id === location.hash);
    rows.forEach((r, j) => r.classList.toggle("on", j === i));
  };
  align(); mark();
  addEventListener("resize", align); addEventListener("hashchange", mark);
  if (document.fonts) document.fonts.ready.then(align);
})();
/* A table that fits needs no tab stop and no hint; one that is wider than the screen keeps both. */
(() => {
  const fit = () => document.querySelectorAll(".table-wrap").forEach(w => {
    if (!w.clientWidth) return;  // inside a closed disclosure: measured when it opens
    const scrolls = w.scrollWidth > w.clientWidth + 1;
    scrolls ? w.setAttribute("tabindex", "0") : w.removeAttribute("tabindex");
    const hint = w.previousElementSibling;
    if (hint && hint.classList.contains("scroll-hint")) hint.hidden = !scrolls;
  });
  fit();
  addEventListener("resize", fit);
  document.querySelectorAll("details").forEach(d => d.addEventListener("toggle", fit));
})();
</script>
</body>
